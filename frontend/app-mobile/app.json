      "package": "com.anonymous.Projet-intégrateur-s"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "e88792e2-46fb-421a-8c09-91b5d9912ea4"
